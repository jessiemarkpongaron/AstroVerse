// Cloudflare Workers static-assets deploy. Committed so Workers Builds uses it as-is instead of
// auto-configuring the project (which adds @cloudflare/vite-plugin and rebuilds, breaking the
// pre-render step in `npm run build`). Build command: `npm run build`; deploy: `npx wrangler deploy`.
{
  "name": "astroverse",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    // Unknown paths get index.html (client-side routes); real files such as
    // dist/signs/gemini.html (served at /signs/gemini) are matched first.
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "astroverse.digitalverseph.com", "custom_domain": true }],
}
