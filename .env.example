# Copy to .env.local for local development. Never commit real values.

# --- Browser (Vite exposes only VITE_* vars to the client) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Open-Meteo geocoding base URL (free tier is non-commercial; see docs/ARCHITECTURE.md)
VITE_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# 'true' shows the AI reading (premium). Leave empty until ANTHROPIC_API_KEY is set below.
VITE_AI_READINGS=

# --- Supabase function secrets (Dashboard → Edge Functions → Secrets, or
#     `npx supabase secrets set`; NEVER in the client or in VITE_* vars) ---
# generate-reading: required for new AI readings (cached readings load without it)
ANTHROPIC_API_KEY=
# optional; defaults to claude-opus-5-5
ANTHROPIC_MODEL=
# optional; comma-separated CORS origins (defaults: live domain + localhost:5173/4173)
ALLOWED_ORIGINS=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Local Supabase Google sign-in (put these in supabase/.env, git-ignored) ---
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
